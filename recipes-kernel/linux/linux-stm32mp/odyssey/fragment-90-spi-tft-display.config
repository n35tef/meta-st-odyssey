# Odyssey 40-pin header: Waveshare 3.5" ILI9486 SPI TFT + XPT2046 touch
#
# The ST stm32mp cleanup fragment disables CONFIG_STAGING and
# CONFIG_FRAMEBUFFER_CONSOLE; re-enable what fbtft / fbcon need. CONFIG_FB,
# CONFIG_FB_CORE/DEVICE, CONFIG_BACKLIGHT_CLASS_DEVICE, CONFIG_INPUT_TOUCHSCREEN
# and CONFIG_SPI are already =y in the base config.

CONFIG_STAGING=y

# fbtft + ILI9486 panel driver (drivers/staging/fbtft)
CONFIG_FB_TFT=m
CONFIG_FB_TFT_ILI9486=m

# XPT2046 / ADS7846 resistive touch on SPI
CONFIG_TOUCHSCREEN_ADS7846=m

# STM32 SPI controller as built-in so SPI5 is up early (base config has it =m)
CONFIG_SPI_STM32=y
CONFIG_SPI_SPIDEV=y

# show the Linux console on the small panel (/dev/fb1); harmless if unused
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
