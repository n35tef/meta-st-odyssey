[Unit]
Description=Odyssey car-dashboard (LVGL, ILI9486 framebuffer + XPT2046 touch)
# fbtft / ads7846 come up via udev during this target
After=systemd-udev-settle.service local-fs.target
Wants=systemd-udev-settle.service

[Service]
Type=simple
Environment=LV_VIDEO_CARD=/dev/fb0
ExecStart=/usr/bin/car-dashboard
Restart=always
RestartSec=2
# quiet the kernel console so it doesn't scribble over the panel
ExecStartPre=-/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null; echo 0 > /proc/sys/kernel/printk 2>/dev/null; true'

[Install]
WantedBy=multi-user.target
